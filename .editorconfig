# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown uses two-space list indentation; trailing spaces can be meaningful
# (a hard line break), so leave both alone.
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab
